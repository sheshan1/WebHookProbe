{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WebHookProbe scenario v1",
  "description": "Runtime also enforces UTF-8 byte limits, URL/header safety, concurrency <= copies, requestTimeoutMs <= verification timeoutMs, and stableForMs < timeoutMs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "targetUrl",
    "headers",
    "body",
    "copies",
    "concurrency",
    "timeoutMs",
    "expectedStatuses"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "targetUrl": {
      "type": "string",
      "pattern": "^https?://"
    },
    "headers": {
      "type": "object",
      "maxProperties": 32,
      "additionalProperties": {
        "type": "string",
        "maxLength": 4096
      }
    },
    "body": {
      "type": "string",
      "maxLength": 65536
    },
    "copies": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "concurrency": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "timeoutMs": {
      "type": "integer",
      "minimum": 10,
      "maximum": 30000
    },
    "expectedStatuses": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "integer",
        "minimum": 100,
        "maximum": 599
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "assertions",
        "pollIntervalMs",
        "timeoutMs",
        "requestTimeoutMs",
        "stableForMs"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https?://"
        },
        "headers": {
          "type": "object",
          "maxProperties": 32,
          "additionalProperties": {
            "type": "string",
            "maxLength": 4096
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "pointer",
              "equals"
            ],
            "properties": {
              "pointer": {
                "type": "string",
                "maxLength": 512,
                "pattern": "^(?:/(?:[^~]|~[01])*)?$"
              },
              "equals": {
                "type": [
                  "string",
                  "number",
                  "boolean",
                  "null"
                ]
              }
            }
          }
        },
        "pollIntervalMs": {
          "type": "integer",
          "minimum": 10,
          "maximum": 5000
        },
        "timeoutMs": {
          "type": "integer",
          "minimum": 100,
          "maximum": 30000
        },
        "requestTimeoutMs": {
          "type": "integer",
          "minimum": 10,
          "maximum": 30000
        },
        "stableForMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 29999
        }
      }
    }
  }
}
