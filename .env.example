# Defaults work without a .env file. Copy this template only to customize them.
# Browser address: http://127.0.0.1:8082
UI_PORT=8082
# Optional sample receiver host port (compose.samples.yaml)
FIXTURE_PORT=8090
# Optional Java/PostgreSQL demo only; your own backend needs none of these.
POSTGRES_USER=webhookprobe
POSTGRES_PASSWORD=webhookprobe-local
DEMO_ENABLED=true
# Native Java development only. Compose supplies its own address/port/JDBC URL.
SERVER_PORT=8080
DATABASE_URL=jdbc:postgresql://127.0.0.1:15432/webhookprobe
